# Resend (server-only). Do not prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=
# Verified sender in Resend, e.g. Tha Shop <appointments@thashops.com>
APPOINTMENT_FROM_EMAIL=
APPOINTMENT_TO_EMAIL=

# GA4 measurement ID. Leave empty until a real property exists.
# Public by design — never put a secret in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Appointment form anti-abuse currently uses a honeypot, a minimum fill time,
# and per-instance in-memory rate limiting. That is not shared across Vercel
# instances. Next step: Vercel Firewall rate limiting or Upstash Redis.
